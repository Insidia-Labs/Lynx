# Lynx settings. Every one is optional; the values shown are the defaults.
#
# Lynx reads real environment variables only and never loads a .env file, because
# it runs inside the repository it scans. Set these with `export`, your CI's
# environment settings, or a tool such as direnv.

# Tool name written into reports.
# LYNX_TOOL_NAME=Lynx

# Link written into reports.
# LYNX_INFORMATION_URI=https://insidialabs.com

# Finding states included in reports, as a JSON list.
# Possible values: candidate, corroborated, proven, refuted.
# LYNX_REPORTED_STATES=["proven", "corroborated"]

# Seconds each detector may run before it's stopped and reported as failed.
# LYNX_DETECTOR_TIMEOUT=600

# Folder for run checkpoints, so an interrupted scan can be resumed.
# LYNX_STATE_DIR=$HOME/.local/state/lynx

# Chat model for each role. Map and skeptic default to a cheaper model,
# investigate and fix to the strongest. Set provider and name together when you
# change a role. provider is anthropic, or openai for any OpenAI-compatible API
# (OpenAI, OpenRouter, vLLM, Ollama, LM Studio): set base_url for anything that
# isn't OpenAI itself. Keys come from ANTHROPIC_API_KEY or OPENAI_API_KEY, never
# from a LYNX_ setting. Check them with `lynx doctor`.
# LYNX_MAP_MODEL__PROVIDER=anthropic
# LYNX_MAP_MODEL__NAME=claude-sonnet-5-5
# LYNX_INVESTIGATE_MODEL__PROVIDER=anthropic
# LYNX_INVESTIGATE_MODEL__NAME=claude-opus-5-5
# LYNX_SKEPTIC_MODEL__PROVIDER=anthropic
# LYNX_SKEPTIC_MODEL__NAME=claude-sonnet-5-5
# LYNX_FIX_MODEL__PROVIDER=anthropic
# LYNX_FIX_MODEL__NAME=claude-opus-5-5
#
# For example, map on a local vLLM server:
# LYNX_MAP_MODEL__PROVIDER=openai
# LYNX_MAP_MODEL__NAME=qwen3.5
# LYNX_MAP_MODEL__BASE_URL=http://localhost:8000/v1
